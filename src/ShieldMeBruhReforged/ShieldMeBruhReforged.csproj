<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>ShieldMeBruhReforged</AssemblyName>
        <RootNamespace>ShieldMeBruhReforged</RootNamespace>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>12</LangVersion>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <Version>1.0.1</Version>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" ExcludeAssets="runtime" />
        <!-- Unity supplies the game's transitive runtime dependencies. -->
        <Reference Include="$(ManagedDir)/assembly_valheim.dll" Publicize="true" Private="false" ExternallyResolved="true" />
        <Reference Include="$(ManagedDir)/assembly_utils.dll" Publicize="true" Private="false" ExternallyResolved="true" />
        <Reference Include="$(ManagedDir)/assembly_guiutils.dll" Publicize="true" Private="false" ExternallyResolved="true" />
        <Reference Include="$(ManagedDir)/UnityEngine*.dll" Private="false" />
        <Reference Include="$(BepInExDir)/core/BepInEx.dll" Private="false" />
        <Reference Include="$(BepInExDir)/core/0Harmony.dll" Private="false" />
        <EmbeddedResource Include="Resources/shield.png" />
    </ItemGroup>
    <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
        <Error Condition="!Exists('$(ManagedDir)/assembly_valheim.dll')" Text="Valheim assemblies were not found in $(ManagedDir). Set GameDir to your current Valheim installation, or ManagedDir to its Managed directory." />
        <Error Condition="!Exists('$(BepInExDir)/core/BepInEx.dll') Or !Exists('$(BepInExDir)/core/0Harmony.dll')" Text="BepInEx or Harmony was not found in $(BepInExDir)/core. Set BepInExDir to your mod profile's BepInEx directory." />
    </Target>
  <Import Project="../../build/Package.targets" />
</Project>
